# ==============================================================================
# MAHASETU MOBILE APPLICATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in the required environment variables below.
# 3. DO NOT commit .env to source control (it is ignored by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOBILE CLIENT CONFIGURATION (Expo / React Native Client)
# ------------------------------------------------------------------------------
# These variables are bundled into the mobile app and prefixed with EXPO_PUBLIC_.
# They must contain client-safe identifiers only — NO private keys or tokens.

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# MahaSetu Trusted Backend URL reachable by mobile app
# For local development: http://localhost:8000 (web) or http://10.0.2.2:8000 (Android emulator)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Development-only demo mode toggle (strictly disabled in production builds)
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_PASSWORD=your_secure_dev_demo_password

# ------------------------------------------------------------------------------
# 2. MAHASETU TRUSTED BACKEND CONFIGURATION (Node.js Server)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Firebase Admin SDK Credentials (File path or raw JSON string)
# NEVER expose to mobile client or commit to repository
FIREBASE_SERVICE_ACCOUNT_JSON=your_service_account_json_or_path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Local conversation store cache path
CONVERSATION_STORE_PATH=.data/user_conversations.json

# ------------------------------------------------------------------------------
# 3. EXTERNAL SERVICE SECRETS (SERVER-SIDE BACKEND ONLY)
# ------------------------------------------------------------------------------
# The following credentials reside strictly on the server and are NEVER exposed
# to the React Native bundle or client runtime.

# Twilio Programmable Messaging API (Statutory Citizen Notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_ENABLED=false

# Google Gemini AI Assistant (@google/genai SDK on backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10
