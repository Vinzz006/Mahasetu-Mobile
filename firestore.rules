rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS (Firebase Auth Custom Claims)
    // - Deny by default: All role checks derived from signed token claims
    // - Requires email_verified for all authenticated requests
    // - ZERO document reads (get()) in authorization helpers
    // - ZERO hardcoded admin emails
    // ==========================================================

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.role in ["ADMIN", "admin"]
        && request.auth.token.status == "APPROVED";
    }

    function isAuditor() {
      return signedIn()
        && request.auth.token.role in ["AUDITOR", "auditor"]
        && request.auth.token.status == "APPROVED";
    }

    function isDepartmentOfficer() {
      return signedIn()
        && request.auth.token.status == "APPROVED"
        && request.auth.token.role in ["DEPARTMENT_A", "DEPARTMENT_B", "DEPARTMENT_C", "department_officer"];
    }

    function isApprovedCitizen() {
      return signedIn()
        && request.auth.token.role in ["CITIZEN", "citizen"]
        && request.auth.token.status == "APPROVED";
    }

    function isDepartment(deptId) {
      return isDepartmentOfficer() && (
        request.auth.token.departmentId == deptId
        || request.auth.token.role == deptId
        || (deptId in ["DEPARTMENT_A", "DEPT_A"] && (request.auth.token.departmentId in ["DEPARTMENT_A", "DEPT_A"] || request.auth.token.role in ["DEPARTMENT_A", "DEPT_A"]))
        || (deptId in ["DEPARTMENT_B", "DEPT_B"] && (request.auth.token.departmentId in ["DEPARTMENT_B", "DEPT_B"] || request.auth.token.role in ["DEPARTMENT_B", "DEPT_B"]))
        || (deptId in ["DEPARTMENT_C", "DEPT_C"] && (request.auth.token.departmentId in ["DEPARTMENT_C", "DEPT_C"] || request.auth.token.role in ["DEPARTMENT_C", "DEPT_C"]))
      );
    }

    // ==========================================================
    // 1. USERS COLLECTION (users/{userId})
    // - Read: Own document, or ADMIN / AUDITOR only.
    // - Create: User can self-create on signup with role=null/pending, status=PENDING/PENDING_APPROVAL, isActive=false.
    // - Update: Self-update restricted to non-privileged profile fields via allowlist.
    // - Privileged role/status/certification assignment is strictly backend Admin SDK.
    // ==========================================================
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isAuditor()
      );
      allow create: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.role == null || request.resource.data.role == "pending")
        && (request.resource.data.status == "PENDING" || request.resource.data.status == "PENDING_APPROVAL")
        && request.resource.data.isActive == false
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "displayName", "role", "departmentId", "status", "isActive",
          "phone", "phoneNumber", "photoURL", "city", "district", "state", "pinCode", "aadhaarRef",
          "isVerified", "createdAt", "updatedAt"
        ]);
      allow update: if signedIn() && (
        isAdmin() || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "name", "phoneNumber", "phone", "photoURL", "city", "district", "state", "pinCode", "updatedAt"
          ])
        )
      );
      allow delete: if false;
    }

    // ==========================================================
    // 2. APPLICATIONS COLLECTION (applications/{appId})
    // - Read: Owning citizen, Department Officers, Admin, Auditor
    // - Writes: STRICTLY backend Admin SDK only (clients cannot create, update, or delete)
    // ==========================================================
    match /applications/{appId} {
      allow read: if signedIn() && (
        resource.data.citizenUid == request.auth.uid
        || resource.data.citizenId == request.auth.uid
        || isDepartmentOfficer()
        || isAdmin()
        || isAuditor()
      );
      allow create, update, delete: if false;
    }

    // ==========================================================
    // 3. APPLICATION VERIFICATIONS (applicationVerifications/{verificationId})
    // - Read: Owning citizen, Admin, Auditor, Department Officers
    // - Writes: STRICTLY backend Admin SDK only (clients cannot touch verification slots)
    // ==========================================================
    match /applicationVerifications/{verificationId} {
      allow read: if signedIn() && (
        resource.data.citizenUid == request.auth.uid
        || resource.data.citizenId == request.auth.uid
        || isAdmin()
        || isAuditor()
        || isDepartmentOfficer()
      );
      allow write: if false;
    }

    // ==========================================================
    // 4. NOTIFICATIONS (notifications/{notifId})
    // ==========================================================
    match /notifications/{notifId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    // ==========================================================
    // 5. CONSENTS (consents/{consentId})
    // - Read: Owning citizen, Department Officers, Admin, Auditor
    // - Update: Citizen may only set status to GRANTED or DENIED
    // ==========================================================
    match /consents/{consentId} {
      allow read: if signedIn() && (
        resource.data.citizenUid == request.auth.uid
        || resource.data.citizenId == request.auth.uid
        || isDepartmentOfficer()
        || isAdmin()
        || isAuditor()
      );
      allow update: if signedIn() && (
        (resource.data.citizenUid == request.auth.uid || resource.data.citizenId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["GRANTED", "DENIED"]
      );
      allow create, delete: if false;
    }

    // ==========================================================
    // 6. DATA EXCHANGES & INTEROPERABILITY (dataExchanges/{exchangeId})
    // ==========================================================
    match /dataExchanges/{exchangeId} {
      allow read: if isAdmin() || isAuditor() || isDepartmentOfficer();
      allow write: if false;
    }

    // ==========================================================
    // 7. INTEGRATION LOGS (integrationLogs/{logId})
    // ==========================================================
    match /integrationLogs/{logId} {
      allow read: if isAdmin() || isAuditor();
      allow write: if false;
    }

    // ==========================================================
    // 8. AUDIT LOGS (auditLogs/{logId})
    // - Tamper-evident: Read-only for Admin & Auditor
    // - Client create strictly bound to authenticated caller UID with allowlist
    // ==========================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isAuditor();
      allow create: if signedIn() && (
        isAdmin() || (
          request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "actorUid", "actorRole", "action", "details", "metadata", "timestamp", "createdAt"
          ])
        )
      );
      allow update, delete: if false;
    }

    // ==========================================================
    // 9. WORKFLOWS (workflows/{workflowId})
    // ==========================================================
    match /workflows/{workflowId} {
      allow read: if isAdmin() || isAuditor() || isDepartmentOfficer();
      allow write: if false;
    }

    // ==========================================================
    // 10. SERVICES CATALOGUE & DEPARTMENTS REGISTRY
    // ==========================================================
    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ==========================================================
    // 11. AI ASSISTANT CONVERSATIONS (aiConversations/{conversationId})
    // ==========================================================
    match /aiConversations/{conversationId} {
      allow read, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
        || isAdmin()
      );

      match /messages/{messageId} {
        allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
        allow update, delete: if false;
      }
    }

    // ==========================================================
    // 12. GOVERNMENT RESIDENT PROFILES (residentProfiles/{uid})
    // - Citizen owner cannot self-certify (forbidden from writing certificationStatus, certifiedAt, certifiedBy, isVerified)
    // ==========================================================
    match /residentProfiles/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || isAuditor()
      );
      allow create: if signedIn() && (
        isAdmin() || (
          request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid
          && (!request.resource.data.keys().hasAny(["certificationStatus", "certifiedAt", "certifiedBy", "isVerified"])
              || request.resource.data.certificationStatus == "PENDING")
          && request.resource.data.keys().hasOnly([
            "userId", "profileType", "personalDetails", "address", "contact",
            "family", "identity", "education", "bank", "passport", "departmentDetails",
            "isComplete", "completionPercentage", "certificationStatus", "createdAt", "updatedAt"
          ])
        )
      );
      allow update: if signedIn() && (
        isAdmin() || (
          request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["certificationStatus", "certifiedAt", "certifiedBy", "isVerified"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "userId", "profileType", "personalDetails", "address", "contact",
            "family", "identity", "education", "bank", "passport", "departmentDetails",
            "isComplete", "completionPercentage", "updatedAt"
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 13. EXPLICIT DEFAULT DENY-ALL
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
