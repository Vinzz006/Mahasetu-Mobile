{
  "name": "mahasetu-mobile",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=9.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "ts-node backend/src/server.ts",
    "test": "npm run test:backend && npm run test:client",
    "test:backend": "node -r ts-node/register --test backend/src/__tests__/*.test.ts",
    "test:client": "node -r ts-node/register --test tests/offline-security.test.ts tests/secret-scanning.test.ts tests/native-intent.test.ts tests/audit-logger-appcheck.test.ts tests/config-security.test.ts tests/demo-security.test.ts tests/input-validation.test.ts tests/storage-service.test.ts tests/session-lifecycle.test.ts tests/error-disclosure.test.ts",
    "scan:secrets": "node -r ts-node/register scripts/scan-secrets.ts",
    "test:rules": "firebase-tools emulators:exec --only firestore run-rules-tests.cmd"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@google/genai": "^2.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.26",
    "expo-asset": "^57.0.18",
    "expo-constants": "^57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "^57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.1",
    "@types/react": "~19.2.4",
    "dotenv": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "tar": "^7.4.3",
    "undici": "^6.28.1",
    "postcss": "^8.5.28",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "node-forge": "^1.3.1",
    "@grpc/grpc-js": "^1.14.5",
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1",
    "@expo/plist": {
      "@xmldom/xmldom": "~0.8.11"
    }
  },
  "private": true
}
